# Variables de entorno que lee el codigo, con su valor por omision.
#
# En desarrollo: copiar este archivo a `.env` en la raiz del repositorio.
# Con Docker (perfil `completo`): copiarlo a `infra/.env`.
# Lo que ya esta definido en el entorno tiene prioridad sobre el archivo.
# Sin definir ninguna, el sistema usa exactamente estos valores.

# --- Base de datos -----------------------------------------------------------
# La contrasena por omision solo es aceptable con la base escuchando en
# 127.0.0.1. Si la base no es local, la API se niega a arrancar con ella.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesis_db
DB_USER=tesis_user
DB_PASSWORD=tesis_pass

# Puerto publicado en el anfitrion por docker-compose. Si se cambia, DB_PORT
# tiene que tener el mismo valor.
DB_PUERTO_ANFITRION=5432

# --- Intermediario MQTT ------------------------------------------------------
# Direccion numerica a proposito: `localhost` puede resolver a ::1.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=tesis/telemetry/live
MQTT_REPLAY_TOPIC=tesis/telemetry/replay
MQTT_CLIENT_ID=tesis-consumidor-telemetria

# Tamano de lote del consumidor y cada cuanto vacia lo pendiente.
MQTT_BATCH_SIZE=5000
MQTT_FLUSH_INTERVAL_SECONDS=0.5

# Garantia de entrega: con confirmacion manual y sesion persistente, un
# consumidor caido no pierde lo que llega mientras no esta.
MQTT_CONFIRMACION_MANUAL=1
MQTT_SESION_PERSISTENTE=1
MQTT_QOS_EN_VIVO=1

# Cero = sin tope propio; el tope efectivo es el de infra/mosquitto.conf.
MQTT_MAX_PENDING_MESSAGES=0

# --- API y tablero -----------------------------------------------------------
# Origenes que el navegador puede leer, separados por coma.
CORS_ORIGENES=http://127.0.0.1:3000,http://localhost:3000

# Si la API sirve tambien el tablero (un solo origen). Encendido en contenedor.
SERVIR_TABLERO=0
DIRECTORIO_TABLERO=./dashboard

# --- Captura de F1 25 --------------------------------------------------------
# Limita la captura al vehiculo propio aunque se pida la parrilla completa.
CAPTURA_SOLO_VEHICULO_PROPIO=0

# --- Docker ------------------------------------------------------------------
# Politica de reinicio de los contenedores (`no` o `unless-stopped`).
DOCKER_REINICIO=no

# --- Restauracion de un respaldo (solo scripts/respaldo_spa.py) --------------
SPA_RESTORE_DSN=host=127.0.0.1 port=5432 dbname=spa_original user=tesis_user password=tesis_pass
