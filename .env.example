# Variables de entorno del proyecto.
#
# COMO SE USA
# -----------
# Copiar este archivo a `.env` en la raiz del repositorio y poner los valores
# que correspondan. `.env` **no se versiona**; este ejemplo si, para que se sepa
# que variables existen sin publicar sus valores.
#
# Lo que ya esta definido en el entorno le gana a este archivo. Ese orden importa:
# una variable puesta por el motor de contenedores o por el servicio del sistema
# tiene que imponerse sobre un `.env` olvidado en el directorio.
#
# Sin `.env`, todo toma los valores por omision de `backend/config.py` y el
# sistema se comporta igual que siempre en esta maquina.

# --- la base ---------------------------------------------------------------
# ESTE ARCHIVO SE COPIA TAL CUAL Y FUNCIONA. No hay que editarlo para levantar
# el proyecto en esta maquina, y esa es toda la idea: un ejemplo que hay que
# corregir antes de que arranque no es un ejemplo, es una trampa. Ya se cayo en
# ella al escribirlo ---se copio con un valor de relleno y la base dejo de
# responder--- de modo que lleva los valores que andan.
#
# La contrasena de abajo es **publica**: esta en el repositorio y en su historial
# desde el primer dia. Sirve para una base que solo escucha en esta maquina y no
# sirve para ninguna otra, y el sistema lo hace cumplir: `verificar_secretos()`
# impide arrancar con este valor si DB_HOST no es local.
#
# EN EL DESPLIEGUE hay que cambiarla. No por prolijidad: alli la base deja de ser
# local y el servicio se niega a arrancar con esta.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tesis_db
DB_USER=tesis_user
DB_PASSWORD=tesis_pass

# --- el intermediario ------------------------------------------------------
# Numerica y no `localhost`: un nombre introduce una resolucion, y la resolucion
# puede caer en algo que acepta la conexion y no contesta nunca. Ya paso.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=tesis/telemetry/live
MQTT_REPLAY_TOPIC=tesis/telemetry/replay
MQTT_CLIENT_ID=tesis-consumidor-telemetria

# --- entrega garantizada ---------------------------------------------------
# La sesion conservada y la confirmacion manual son lo que hace que un corte del
# consumidor no pierda mensajes. Apagarlas cambia lo que el capitulo de pruebas
# mide, de modo que no se tocan sin rehacer esa medicion.
MQTT_SESION_PERSISTENTE=1
MQTT_QOS_EN_VIVO=1
MQTT_CONFIRMACION_MANUAL=1
